# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 git 에 올라가지 않습니다)
# 여기 값들은 "비밀"입니다. 화면 코드(web, app)나 채팅·캡처에 넣지 마세요.

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio 에서 발급 (비워 두면 AI 대신 규칙으로 일정을 짭니다)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 공공데이터포털 > 한국관광공사 국문 관광정보 서비스 (비워 두면 샘플 데이터만 쓸 수 있습니다)
TOUR_API_KEY=

# 이 서버의 공개 주소 (보통 비워 둠. 배포 후 사진 주소가 http 로 나올 때만 https://... 를 넣음)
PUBLIC_API_URL=

# 이 서버를 불러도 되는 화면 주소 (쉼표로 구분). 배포 후 웹·앱 주소를 추가합니다.
ALLOWED_ORIGINS=http://localhost:3000
