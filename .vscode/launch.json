{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "서버 디버그 (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload"],
      "cwd": "${workspaceFolder}/api",
      "env": { "PYTHONUTF8": "1" },
      "jinja": false
    },
    {
      "name": "앱 실행 (Flutter)",
      "type": "dart",
      "request": "launch",
      "cwd": "app",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file=env.json"]
    }
  ]
}
